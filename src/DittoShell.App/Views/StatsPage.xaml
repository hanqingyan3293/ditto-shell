<UserControl x:Class="DittoShell.App.Views.StatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DittoShell.App.Controls"
             xmlns:loc="clr-namespace:DittoShell.App.Markup">

  <Grid Background="{DynamicResource B.Bg}">
        <Grid.RowDefinitions>
          <RowDefinition Height="44"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

<!-- 顶部：返回 + 标题 -->
        <Grid Grid.Row="0">
          <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
            <Button Style="{StaticResource FlatButton}" Height="30" Padding="8,0" Click="Back_Click"
                    ToolTip="返回剪贴板">
              <StackPanel Orientation="Horizontal">
                <controls:Icon Kind="ChevronLeft" Width="14" Height="14" Stroke="{DynamicResource B.Text2}"/>
                <TextBlock Text="返回" FontSize="12.5" Margin="3,0,0,0" Foreground="{DynamicResource B.Text2}"/>
              </StackPanel>
            </Button>
            <TextBlock Text="{loc:Str stats.title}" FontSize="13.5" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

          <StackPanel Margin="24,18">
            <!-- 三张指标卡 -->
            <UniformGrid Columns="3">
              <Border Background="{DynamicResource B.CardBg}" CornerRadius="8" Padding="16" Margin="0,0,10,0"
                      BorderBrush="{DynamicResource B.Divider}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="{loc:Str stats.total}" FontSize="11.5" Foreground="{DynamicResource B.Text3}"/>
                  <TextBlock x:Name="TotalText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,2"/>
                  <TextBlock x:Name="TrendText" Text="—" FontSize="10.5" Foreground="{DynamicResource B.Success}"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource B.CardBg}" CornerRadius="8" Padding="16" Margin="5,0"
                      BorderBrush="{DynamicResource B.Divider}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="{loc:Str stats.today}" FontSize="11.5" Foreground="{DynamicResource B.Text3}"/>
                  <TextBlock x:Name="TodayText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,2"/>
                  <TextBlock Text="今日 07:10 起" FontSize="10.5" Foreground="{DynamicResource B.Text3}"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource B.CardBg}" CornerRadius="8" Padding="16" Margin="10,0,0,0"
                      BorderBrush="{DynamicResource B.Divider}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="{loc:Str stats.storage}" FontSize="11.5" Foreground="{DynamicResource B.Text3}"/>
                  <TextBlock x:Name="SizeText" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,2"/>
                  <TextBlock x:Name="SizeHint" Text="—" FontSize="10.5" Foreground="{DynamicResource B.Warning}"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- 14 天柱状图 -->
            <TextBlock Text="{loc:Str stats.byDay}" FontSize="13" FontWeight="SemiBold" Margin="0,26,0,12"/>
            <Border Background="{DynamicResource B.CardBg}" CornerRadius="8" Padding="18,16"
                    BorderBrush="{DynamicResource B.Divider}" BorderThickness="1">
              <ItemsControl x:Name="DailyBars" Height="150">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid VerticalAlignment="Bottom">
                      <Border Width="18" Height="{Binding Height}" CornerRadius="3"
                              Background="{Binding Brush}" VerticalAlignment="Bottom"
                              HorizontalAlignment="Center" ToolTip="{Binding Tip}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <!-- 类型分布 -->
            <TextBlock Text="分组分布（Top 10）" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,8"/>
          <Border Background="{DynamicResource B.CardBg}" CornerRadius="4" Padding="16,8"
                  BorderBrush="{DynamicResource B.Divider}" BorderThickness="1" Margin="0,0,0,16">
            <ItemsControl x:Name="GroupDistList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="30">
                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Border Height="6" Width="{Binding BarWidth}" CornerRadius="3"
                              Background="{DynamicResource B.Primary}" Margin="0,0,8,0"/>
                      <TextBlock Text="{Binding CountText}" FontSize="11.5"
                                 Foreground="{DynamicResource B.Text3}" MinWidth="70" TextAlignment="Right"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <TextBlock Text="标签使用（Top 10）" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,8"/>
          <Border Background="{DynamicResource B.CardBg}" CornerRadius="4" Padding="16,8"
                  BorderBrush="{DynamicResource B.Divider}" BorderThickness="1" Margin="0,0,0,16">
            <ItemsControl x:Name="TagDistList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="28">
                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CountText}" FontSize="11.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource B.Text3}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <TextBlock Text="来源应用（Top 10）" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,8"/>
          <Border Background="{DynamicResource B.CardBg}" CornerRadius="4" Padding="16,8"
                  BorderBrush="{DynamicResource B.Divider}" BorderThickness="1" Margin="0,0,0,16">
            <ItemsControl x:Name="SourceDistList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="28">
                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CountText}" FontSize="11.5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource B.Text3}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <TextBlock Text="内容类型" FontSize="13" FontWeight="SemiBold" Margin="0,24,0,10"/>
            <Border Background="{DynamicResource B.CardBg}" CornerRadius="8" Padding="18"
                    BorderBrush="{DynamicResource B.Divider}" BorderThickness="1">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <TextBlock Text="文本" FontSize="12"/>
                  <TextBlock Text="5,461  ·  88%" HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource B.Text3}"/>
                </Grid>
                <Border Height="4" CornerRadius="2" Background="{DynamicResource B.Divider}">
                  <Border Width="88" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource B.Primary}"/>
                </Border>
                <Grid Margin="0,14,0,10">
                  <TextBlock Text="链接" FontSize="12"/>
                  <TextBlock Text="2,834  ·  46%" HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource B.Text3}"/>
                </Grid>
                <Border Height="4" CornerRadius="2" Background="{DynamicResource B.Divider}">
                  <Border Width="46" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource B.Cyan}"/>
                </Border>
                <Grid Margin="0,14,0,10">
                  <TextBlock Text="图片" FontSize="12"/>
                  <TextBlock Text="113  ·  2%" HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource B.Text3}"/>
                </Grid>
                <Border Height="4" CornerRadius="2" Background="{DynamicResource B.Divider}">
                  <Border Width="8" HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource B.Magenta}"/>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
  </Grid>
</UserControl>
