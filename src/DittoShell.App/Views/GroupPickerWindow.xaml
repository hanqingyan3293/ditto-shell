<Window x:Class="DittoShell.App.Views.GroupPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DittoShell.App.Controls"
        Title="移到分组" Width="400" Height="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" FontFamily="{StaticResource Font.UI}"
        Icon="pack://application:,,,/Assets/app.ico">

  <!-- 外层留 10px 给阴影 -->
  <Grid Margin="10">
    <Border Background="{DynamicResource B.Bg}" CornerRadius="8"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                          Opacity="0.18" Color="#101828"/>
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <!-- ═══ 标题栏 ═══ -->
        <Grid Grid.Row="0" Background="{DynamicResource B.BgSide}"
              MouseLeftButtonDown="TitleBar_Drag">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
            <controls:Icon Kind="Folder" Width="14" Height="14"
                           Stroke="{DynamicResource B.Primary}" Margin="0,0,8,0"/>
            <TextBlock Text="移到分组" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}"/>
          </StackPanel>
          <Button HorizontalAlignment="Right" Width="30" Height="30" Margin="0,0,6,0"
                  Style="{StaticResource FlatButton}" Background="Transparent"
                  Click="Cancel_Click">
            <controls:Icon Kind="Close" Width="12" Height="12"
                           Stroke="{DynamicResource B.Text3}"/>
          </Button>
        </Grid>

        <!-- ═══ 搜索框 ═══ -->
        <Border Grid.Row="1" Margin="12,10,12,6"
                Background="{DynamicResource B.InputBg}" CornerRadius="5"
                BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:Icon Grid.Column="0" Kind="Search" Width="13" Height="13"
                           Stroke="{DynamicResource B.Text3}" Margin="9,0,6,0"
                           VerticalAlignment="Center"/>

            <TextBox x:Name="SearchBox" Grid.Column="1"
                     Style="{StaticResource BorderlessTextBox}"
                     FontSize="12" Height="30" VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>

            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1"
                       Text="搜索分组名…" FontSize="12" Margin="2,0,0,0"
                       Foreground="{DynamicResource B.Text3}"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>

            <Button x:Name="ClearSearchBtn" Grid.Column="2" Width="24" Height="24"
                    Margin="0,0,4,0" Padding="0" Style="{StaticResource FlatButton}"
                    Background="Transparent" Click="ClearSearch_Click"
                    Visibility="Collapsed">
              <controls:Icon Kind="Close" Width="10" Height="10"
                             Stroke="{DynamicResource B.Text3}"/>
            </Button>
          </Grid>
        </Border>

        <!-- ═══ 分组树 ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="8,0">
          <ItemsControl x:Name="GroupListBox">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="rowBg" Height="38" CornerRadius="5"
                        Background="Transparent" Cursor="Hand" Margin="0,1"
                        Tag="{Binding}" MouseLeftButtonUp="Group_Click"
                        MouseEnter="Row_Enter" MouseLeave="Row_Leave">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 选中/悬停竖条 -->
                    <Border x:Name="accent" Grid.Column="0" Width="3" CornerRadius="1.5"
                            Margin="-4,6,0,6" Background="{DynamicResource B.Primary}"
                            Visibility="Collapsed"/>

                    <!-- 折叠箭头（有子级才显示） -->
                    <Button Grid.Column="1" Width="16" Height="16" Padding="0"
                            Style="{StaticResource FlatButton}" Background="Transparent"
                            Tag="{Binding}" Click="RowArrow_Click"
                            Visibility="{Binding ShowArrow, Converter={StaticResource BoolToVis}}">
                      <controls:Icon Width="9" Height="9"
                                     Stroke="{DynamicResource B.Text3}"
                                     Kind="{Binding ArrowGlyph}"/>
                    </Button>

                    <!-- 层级缩进 + 连接线 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <Border Width="{Binding TreeNodeIndent}"/>
                      <TextBlock Text="{Binding TreeNodeConnector}"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="10.5"
                                 Foreground="{DynamicResource B.Text3}"
                                 VerticalAlignment="Center" Margin="0,0,4,0"
                                 Visibility="{Binding TreeNodeConnectorVisible, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <!-- 组名（按深度分级） -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center">
                      <Ellipse Width="5" Height="5" Fill="{Binding DotBrush}"
                               Margin="0,0,7,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name}"
                                 FontSize="{Binding TreeNodeFontSize}"
                                 FontWeight="{Binding TreeNodeWeight}"
                                 Foreground="{Binding TreeNodeBrush}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- 条数 -->
                    <TextBlock Grid.Column="4" Text="{Binding Count}" FontSize="11"
                               Foreground="{DynamicResource B.Text3}"
                               Margin="8,0,10,0" VerticalAlignment="Center"/>
                  </Grid>
                </Border>

                <DataTemplate.Triggers>
                  <Trigger SourceName="rowBg" Property="IsMouseOver" Value="True">
                    <Setter TargetName="rowBg" Property="Background"
                            Value="{DynamicResource B.Hover}"/>
                  </Trigger>
                  <DataTrigger Binding="{Binding IsSelectedMatch}" Value="True">
                    <Setter TargetName="rowBg" Property="Background"
                            Value="{DynamicResource B.Selected}"/>
                    <Setter TargetName="accent" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 空状态 -->
        <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="没有匹配的分组"
                   FontSize="11.5" Foreground="{DynamicResource B.Text3}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- ═══ 底部按钮 ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource B.BgSide}"
                BorderBrush="{DynamicResource B.Divider}" BorderThickness="0,1,0,0">
          <Grid Margin="14,0">
            <TextBlock x:Name="HintText" FontSize="10.5"
                       Foreground="{DynamicResource B.Text3}"
                       VerticalAlignment="Center"
                       Text="点击分组直接移入"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Button Content="取消" Style="{StaticResource ChipButton}"
                      Height="30" Width="72" Click="Cancel_Click"/>
              <Button x:Name="ConfirmBtn" Content="移动" Style="{StaticResource PrimaryButton}"
                      Height="30" Width="80" Margin="8,0,0,0"
                      Click="Confirm_Click" IsEnabled="False"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
