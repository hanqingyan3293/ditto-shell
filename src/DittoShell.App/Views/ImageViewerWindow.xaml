<Window x:Class="DittoShell.App.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DittoShell.App.Controls"
        Title="Image" Width="1000" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        UseLayoutRounding="True">

  <Border Background="#F2000000" CornerRadius="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.45" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="34"/>
      </Grid.RowDefinitions>

      <!-- 顶部工具条 -->
      <Grid Grid.Row="0" Background="#14FFFFFF" MouseLeftButtonDown="Bar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TitleText" Grid.Column="0" Margin="14,0,0,0" VerticalAlignment="Center"
                   FontSize="12.5" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Width="38" Height="40" Style="{StaticResource FlatButton}" Click="Fit_Click" ToolTip="适应窗口 (双击图片)">
            <controls:Icon Kind="Maximize" Width="14" Height="14" Stroke="#CCFFFFFF"/>
          </Button>
          <Button Width="38" Height="40" Style="{StaticResource FlatButton}" Click="Actual_Click" ToolTip="原始大小 1:1">
            <TextBlock Text="1:1" FontSize="11" Foreground="#CCFFFFFF"/>
          </Button>
          <Button Width="40" Height="40" Style="{StaticResource FlatButton}" Click="Close_Click" ToolTip="关闭 (Esc)">
            <controls:Icon Kind="Close" Width="12" Height="12" Stroke="#CCFFFFFF"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- 画布 -->
      <Grid Grid.Row="1" x:Name="Host" Background="#0AFFFFFF" ClipToBounds="True"
            MouseWheel="Host_MouseWheel"
            MouseLeftButtonDown="Host_MouseLeftButtonDown"
            MouseLeftButtonUp="Host_MouseLeftButtonUp"
            MouseMove="Host_MouseMove"
            Cursor="SizeAll">

        <Image x:Name="Img" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10"
               RenderTransformOrigin="0.5,0.5">
          <Image.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="ScaleT"/>
              <TranslateTransform x:Name="TransT"/>
            </TransformGroup>
          </Image.RenderTransform>
        </Image>
      </Grid>

      <!-- 底部状态 -->
      <Grid Grid.Row="2" Background="#14FFFFFF">
        <TextBlock x:Name="ZoomText" Margin="14,0,0,0" VerticalAlignment="Center"
                   FontSize="11" Foreground="#99FFFFFF"/>
        <TextBlock HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center"
                   FontSize="11" Foreground="#99FFFFFF"
                   Text="滚轮缩放 · 左键拖动 · 双击复位 · Esc 关闭"/>
      </Grid>
    </Grid>
  </Border>
</Window>
