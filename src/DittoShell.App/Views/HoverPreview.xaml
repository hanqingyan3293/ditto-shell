<UserControl x:Class="DittoShell.App.Views.HoverPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DittoShell.App.Controls">

  <Border Width="380" MaxHeight="460" Background="{DynamicResource B.Bg}" CornerRadius="10"
          BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.22" Color="#101828"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 图片区（无图时折叠） -->
      <Border Grid.Row="0" x:Name="ImageHost" CornerRadius="8,8,0,0" ClipToBounds="True"
              Visibility="Collapsed" Background="#F5F5F5">
        <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="300"/>
      </Border>

      <!-- 文本区 -->
      <Border Grid.Row="1" x:Name="BodyHost" Padding="13,11" MaxHeight="220">
        <TextBlock x:Name="BodyText" FontSize="12" LineHeight="19" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource B.Text2}"/>
      </Border>

      <!-- 元信息 -->
      <Border Grid.Row="2" Padding="13,0,13,11">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="KindBadge" CornerRadius="3" Padding="6,0" Height="17" VerticalAlignment="Center">
            <TextBlock x:Name="KindText" FontSize="10" Foreground="White"/>
          </Border>
          <TextBlock x:Name="MetaText" FontSize="10.5" Margin="8,0,0,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource B.Text3}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
