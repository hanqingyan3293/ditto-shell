<Window x:Class="DittoShell.App.Views.AiOrganizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DittoShell.App.Controls"
        Title="AI 整理" Width="860" Height="880"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        MinWidth="760" MinHeight="640"
        Icon="pack://application:,,,/Assets/app.ico">

  <Grid Margin="10">
    <Border Background="{DynamicResource B.Bg}" CornerRadius="8"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="5" Direction="270"
                          Opacity="0.18" Color="#101828"/>
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="62"/>
        </Grid.RowDefinitions>

        <!-- ═══ 标题栏 ═══ -->
        <Grid Grid.Row="0" Background="{DynamicResource B.BgSide}"
              MouseLeftButtonDown="TitleBar_Drag">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <controls:Icon Kind="Wand" Width="16" Height="16"
                           Stroke="{DynamicResource B.Purple}" Margin="0,0,9,0"/>
            <TextBlock Text="AI 整理" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}"/>
          </StackPanel>
          <Button HorizontalAlignment="Right" Width="32" Height="32" Margin="0,0,8,0"
                  Style="{StaticResource FlatButton}" Background="Transparent" Click="Close_Click">
            <controls:Icon Kind="Close" Width="12" Height="12" Stroke="{DynamicResource B.Text3}"/>
          </Button>
        </Grid>

        <!-- ═══ 主内容 ═══ -->
        <ScrollViewer Grid.Row="1" x:Name="MainScroll" VerticalScrollBarVisibility="Auto"
                      Padding="20,16">
          <StackPanel>

            <!-- ═══════ ① 整理范围 ═══════ -->
            <TextBlock Text="① 整理范围" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}" Margin="0,0,0,10"/>

            <StackPanel Margin="0,0,0,20">
              <RadioButton x:Name="ModeIncremental" GroupName="mode" IsChecked="True"
                           Margin="0,0,0,10" Checked="Mode_Changed">
                <StackPanel>
                  <TextBlock Text="增量整理" FontSize="12.5" Foreground="{DynamicResource B.Text}"/>
                  <TextBlock x:Name="IncrementalDesc" FontSize="10.5"
                             Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0"
                             Text="只处理新增的，已整理过的跳过"/>
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="ModeFull" GroupName="mode" Margin="0,0,0,10"
                           Checked="Mode_Changed">
                <StackPanel>
                  <TextBlock Text="全部重来" FontSize="12.5" Foreground="{DynamicResource B.Text}"/>
                  <TextBlock x:Name="FullDesc" FontSize="10.5"
                             Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0"
                             Text="重新分类所有条目（包括已分组的）"/>
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="ModeRetry" GroupName="mode" Checked="Mode_Changed">
                <StackPanel>
                  <TextBlock Text="补漏重试" FontSize="12.5" Foreground="{DynamicResource B.Text}"/>
                  <TextBlock x:Name="RetryDesc" FontSize="10.5"
                             Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0"
                             Text="只重试之前失败的"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>

            <!-- ═══════ ② 要改什么 ═══════ -->
            <TextBlock Text="② 要改什么" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}" Margin="0,0,0,10"/>

            <Border Background="{DynamicResource B.BgSide}" CornerRadius="6"
                    Padding="14,12" Margin="0,0,0,20">
              <StackPanel>
                <CheckBox x:Name="ChangeGroupsCheck" IsChecked="True" Margin="0,0,0,10">
                  <TextBlock Text="调整分组" FontSize="12" Foreground="{DynamicResource B.Text}"/>
                </CheckBox>

                <CheckBox x:Name="ChangeTagsCheck" IsChecked="True" Margin="0,0,0,8"
                          Checked="ChangeTags_Changed" Unchecked="ChangeTags_Changed">
                  <TextBlock Text="调整标签" FontSize="12" Foreground="{DynamicResource B.Text}"/>
                </CheckBox>

                <!-- 标签模式 -->
                <StackPanel x:Name="TagModePanel" Margin="24,4,0,0">
                  <RadioButton x:Name="TagModeOverwrite" GroupName="tagmode" IsChecked="True"
                               Content="重新打标签（覆盖）" FontSize="11.5" Margin="0,0,0,6"/>
                  <RadioButton x:Name="TagModeOnlyEmpty" GroupName="tagmode"
                               Content="只给没有标签的加" FontSize="11.5" Margin="0,0,0,6"/>
                  <RadioButton x:Name="TagModeAppend" GroupName="tagmode"
                               Content="保留已有标签，追加新标签" FontSize="11.5" Margin="0,0,0,6"/>
                  <RadioButton x:Name="TagModeSkip" GroupName="tagmode"
                               Content="完全不动标签" FontSize="11.5"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- ═══════ ③ 要保护什么 ═══════ -->
            <TextBlock Text="③ 要保护什么" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}" Margin="0,0,0,10"/>

            <Border Background="{DynamicResource B.BgSide}" CornerRadius="6"
                    Padding="14,12" Margin="0,0,0,20">
              <StackPanel>
                <CheckBox x:Name="KeepManualCheck" IsChecked="True" Margin="0,0,0,10"
                          Checked="Protect_Changed" Unchecked="Protect_Changed">
                  <StackPanel>
                    <TextBlock Text="保留我手动分类的条目" FontSize="12"
                               Foreground="{DynamicResource B.Text}"/>
                    <TextBlock x:Name="KeepManualDesc" FontSize="10"
                               Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0"/>
                  </StackPanel>
                </CheckBox>

                <CheckBox x:Name="SkipSecretsCheck" IsChecked="True" Margin="0,0,0,10"
                          Checked="Protect_Changed" Unchecked="Protect_Changed">
                  <TextBlock x:Name="SkipSecretsText" FontSize="12"
                             Foreground="{DynamicResource B.Text}"/>
                </CheckBox>

                <CheckBox x:Name="SkipImagesCheck" IsChecked="True" Margin="0,0,0,10"
                          Checked="Protect_Changed" Unchecked="Protect_Changed">
                  <TextBlock x:Name="SkipImagesText" FontSize="12"
                             Foreground="{DynamicResource B.Text}"/>
                </CheckBox>

                <CheckBox IsChecked="True" IsEnabled="False">
                  <TextBlock x:Name="SkipPrivateText" FontSize="12"
                             Foreground="{DynamicResource B.Text3}"/>
                </CheckBox>
              </StackPanel>
            </Border>

            <!-- ═══════ ④ 自然语言 ═══════ -->
            <TextBlock Text="④ 用自然语言告诉 AI（可选）" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}" Margin="0,0,0,10"/>

            <Border Background="{DynamicResource B.InputBg}" CornerRadius="6"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                    Margin="0,0,0,6">
              <TextBox x:Name="PromptBox" Style="{StaticResource BorderlessTextBox}"
                       Margin="12,10" MinHeight="64" MaxHeight="120"
                       TextWrapping="Wrap" AcceptsReturn="True" FontSize="12"
                       VerticalContentAlignment="Top"/>
            </Border>

            <Grid Margin="0,0,0,10">
              <TextBlock FontSize="10" Foreground="{DynamicResource B.Text3}"
                         VerticalAlignment="Center"
                         Text="例：保留手动分过组的，不改凭据的标签，标签控制在 30 个以内"/>
              <Button x:Name="ParseBtn" Content="解析约束" HorizontalAlignment="Right"
                      Style="{StaticResource ChipButton}" Height="26" Padding="10,0"
                      Click="Parse_Click"/>
            </Grid>

            <!-- 解析结果 -->
            <Border x:Name="ParseResultBox" Background="#FFF0F7FF" CornerRadius="6"
                    BorderBrush="{DynamicResource B.Primary}" BorderThickness="1"
                    Padding="12,10" Margin="0,0,0,20" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="ParseTitleText" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource B.Primary}" Margin="0,0,0,6"/>
                <TextBlock x:Name="ParseDetailText" FontSize="10.5"
                           Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap"
                           LineHeight="18"/>
              </StackPanel>
            </Border>

            <!-- ═══════ ⑤ 分析方案 ═══════ -->
            <TextBlock Text="⑤ 分类方案" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}" Margin="0,0,0,10"/>

            <Border Background="{DynamicResource B.BgSide}" CornerRadius="6"
                    Padding="14,12" Margin="0,0,0,20">
              <CheckBox x:Name="AnalyzeFirstCheck" IsChecked="True"
                        Checked="AnalyzeFirst_Changed" Unchecked="AnalyzeFirst_Changed">
                <StackPanel>
                  <TextBlock Text="让 AI 先分析 500 条样本，生成分组方案 + 标签词表"
                             FontSize="12" Foreground="{DynamicResource B.Text}"/>
                  <TextBlock FontSize="10" Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0"
                             Text="不分析则直接分类，分组和标签会不一致"/>
                </StackPanel>
              </CheckBox>
            </Border>

            <!-- ═══════ 进度 ═══════ -->
            <Border x:Name="ProgressArea" Background="{DynamicResource B.BgSide}"
                    CornerRadius="6" Padding="14,12" Margin="0,0,0,20" Visibility="Collapsed">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <TextBlock x:Name="PhaseText" FontSize="11.5"
                             Foreground="{DynamicResource B.Text2}"/>
                  <TextBlock x:Name="StatsText" FontSize="10.5" HorizontalAlignment="Right"
                             Foreground="{DynamicResource B.Text3}"/>
                </Grid>
                <Border Height="4" CornerRadius="2" Background="{DynamicResource B.InputBg}">
                  <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Width="0"
                          HorizontalAlignment="Left" Background="{DynamicResource B.Primary}"/>
                </Border>
              </StackPanel>
            </Border>

            <!-- ═══════ 方案审阅区 ═══════ -->
            <StackPanel x:Name="SchemeArea" Visibility="Collapsed">
              <TextBlock Text="⑥ 审阅分组方案" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource B.Text}" Margin="0,0,0,10"/>

              <Border Background="{DynamicResource B.InputBg}" CornerRadius="6"
                      Padding="14,12" Margin="0,0,0,12">
                <TextBlock x:Name="ProfileText" FontSize="12"
                           Foreground="{DynamicResource B.Text2}"
                           TextWrapping="Wrap" LineHeight="20"/>
              </Border>

              <StackPanel x:Name="SchemeTabs" Orientation="Horizontal" Margin="0,0,0,12"/>

              <TextBlock x:Name="RecommendText" FontSize="11"
                         Foreground="{DynamicResource B.Purple}" Margin="0,0,0,12"
                         TextWrapping="Wrap"/>

              <Border BorderBrush="{DynamicResource B.Divider}" BorderThickness="1"
                      CornerRadius="6" MaxHeight="240" Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="SchemeGroupList" Margin="8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Height="42" CornerRadius="5" Padding="10,0" Margin="0,1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Path}" FontSize="12"
                                         Foreground="{DynamicResource B.Text}"/>
                              <TextBlock Text="{Binding Reason}" FontSize="10"
                                         Foreground="{DynamicResource B.Text3}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding EstimateText}" FontSize="10.5"
                                       Foreground="{DynamicResource B.Text3}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <Button Grid.Column="3" Width="26" Height="26" Padding="0"
                                    Style="{StaticResource FlatButton}" Background="Transparent"
                                    Tag="{Binding}" Click="RenameGroup_Click" ToolTip="改名">
                              <controls:Icon Kind="Pencil" Width="11" Height="11"
                                             Stroke="{DynamicResource B.Text3}"/>
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <!-- 标签词表 -->
              <Grid Margin="0,0,0,10">
                <TextBlock x:Name="VocabTitle" Text="⑦ 标签词表"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource B.Text}"/>
                <TextBlock x:Name="VocabCountText" FontSize="10.5"
                           Foreground="{DynamicResource B.Text3}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>

              <Border BorderBrush="{DynamicResource B.Divider}" BorderThickness="1"
                      CornerRadius="6" Padding="12,10" MaxHeight="160" Margin="0,0,0,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="VocabList">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource B.InputBg}" CornerRadius="4"
                                Padding="9,4" Margin="0,0,7,7">
                          <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Name}" FontSize="11"
                                       Foreground="{DynamicResource B.Text2}"
                                       VerticalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <!-- 按方案开始分类 -->
              <Button x:Name="RunSchemeBtn" Content="按这个方案开始分类"
                      Style="{StaticResource PrimaryButton}"
                      Height="40" FontSize="13" FontWeight="SemiBold"
                      Margin="0,0,0,8" Click="RunScheme_Click"/>
            </StackPanel>

            <!-- ═══════ 结果区 ═══════ -->
            <StackPanel x:Name="ResultArea" Visibility="Collapsed" Margin="0,0,0,0">
              <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="整理结果" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource B.Text}"/>
                  <TextBlock x:Name="ResultCountText" FontSize="11"
                             Foreground="{DynamicResource B.Text3}" Margin="8,0,0,0"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="全选" Style="{StaticResource FlatButton}" Height="24"
                          Padding="10,0" Click="SelectAll_Click"/>
                  <Button Content="全不选" Style="{StaticResource FlatButton}" Height="24"
                          Padding="10,0" Margin="6,0,0,0" Click="SelectNone_Click"/>
                </StackPanel>
              </Grid>

              <Border BorderBrush="{DynamicResource B.Divider}" BorderThickness="1"
                      CornerRadius="6" MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="ResultList" Margin="8">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="5" Padding="10,8" Margin="0,1">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="Transparent"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuarantine}" Value="True">
                                  <Setter Property="Background" Value="#0F000000"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>

                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                      VerticalAlignment="Top" Margin="0,2,12,0"/>

                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Preview}" FontSize="11.5"
                                         Foreground="{DynamicResource B.Text}"
                                         TextTrimming="CharacterEllipsis"/>
                              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="→ " FontSize="10"
                                           Foreground="{DynamicResource B.Text3}"/>
                                <TextBlock Text="{Binding GroupDisplay}" FontSize="10"
                                           Foreground="{DynamicResource B.Primary}"/>
                                <TextBlock Text="{Binding TagDisplay}" FontSize="10"
                                           Foreground="{DynamicResource B.Text3}" Margin="10,0,0,0"/>
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- ═══ 底部按钮 ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource B.BgSide}"
                BorderBrush="{DynamicResource B.Divider}" BorderThickness="0,1,0,0">
          <Grid Margin="20,0">
            <TextBlock x:Name="StatusText" FontSize="11"
                       Foreground="{DynamicResource B.Text3}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="440"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Button x:Name="CancelRunBtn" Content="停止" Style="{StaticResource ChipButton}"
                      Height="32" Width="76" Click="CancelRun_Click" Visibility="Collapsed"/>
              <Button Content="关闭" Style="{StaticResource ChipButton}" Height="32" Width="76"
                      Margin="8,0,0,0" Click="Close_Click"/>
              <Button x:Name="PreviewBtn" Content="预览" Style="{StaticResource ChipButton}"
                      Height="32" Width="76" Margin="8,0,0,0" Click="Preview_Click"/>
              <Button x:Name="StartBtn" Content="开始" Style="{StaticResource PrimaryButton}"
                      Height="32" MinWidth="120" Padding="14,0" Margin="8,0,0,0"
                      Click="Start_Click"/>
              <Button x:Name="ApplyBtn" Content="应用" Style="{StaticResource PrimaryButton}"
                      Height="32" MinWidth="110" Padding="14,0" Margin="8,0,0,0"
                      Click="Apply_Click" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
