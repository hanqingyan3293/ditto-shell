<Window x:Class="DittoShell.App.Views.AiOrganizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DittoShell.App.Controls"
        Title="AI 整理" Width="820" Height="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        MinWidth="700" MinHeight="600">

  <Grid Margin="10">
    <Border Background="{DynamicResource B.Bg}" CornerRadius="6"
            BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270"
                          Opacity="0.16" Color="#101828"/>
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="{DynamicResource B.BgSide}"
              MouseLeftButtonDown="TitleBar_Drag">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
            <controls:Icon Kind="Wand" Width="15" Height="15"
                           Stroke="{DynamicResource B.Purple}" Margin="0,0,8,0"/>
            <TextBlock Text="AI 整理未归类条目" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}"/>
          </StackPanel>

          <Button HorizontalAlignment="Right" Width="30" Height="30" Margin="0,0,8,0"
                  Style="{StaticResource FlatButton}" Background="Transparent" Click="Close_Click">
            <controls:Icon Kind="Close" Width="12" Height="12"
                           Stroke="{DynamicResource B.Text3}"/>
          </Button>
        </Grid>

        <!-- 主内容（可滚动） -->
        <ScrollViewer Grid.Row="1" x:Name="MainScroll" VerticalScrollBarVisibility="Auto"
                      Padding="16,12">
          <StackPanel>

            <!-- ═══ 首次引导 ═══ -->
            <Border x:Name="IntroBox" Background="#FFF7F0FF" CornerRadius="6"
                    BorderBrush="{DynamicResource B.Purple}" BorderThickness="1"
                    Padding="14,12" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="💡 这是什么？" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource B.Purple}" Margin="0,0,0,8"/>
                <TextBlock FontSize="11.5" Foreground="{DynamicResource B.Text2}"
                           TextWrapping="Wrap" LineHeight="20"
                           Text="AI 会读你的未归类条目，建议它们该进哪个分组。&#10;跑完后会列出所有建议，你勾选想要的，点「应用」才会真的写进 Ditto。不点应用不会改任何数据。"/>
                <Button Content="知道了" Style="{StaticResource ChipButton}" Height="26"
                        HorizontalAlignment="Right" Margin="0,10,0,0" Click="DismissIntro_Click"/>
              </StackPanel>
            </Border>

            <!-- ═══ ① 方式 ═══ -->
            <TextBlock Text="① 选择方式" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}" Margin="0,0,0,8"/>

            <StackPanel Margin="0,0,0,16">
              <RadioButton x:Name="ModeIncremental" GroupName="mode" IsChecked="True"
                           Margin="0,0,0,8" Checked="Mode_Changed">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="增量整理" FontSize="12"
                               Foreground="{DynamicResource B.Text}"/>
                    <Border Background="{DynamicResource B.Primary}" CornerRadius="3"
                            Padding="5,1" Margin="6,0,0,0">
                      <TextBlock Text="推荐" FontSize="9.5" Foreground="White"/>
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="IncrementalDesc" FontSize="10.5"
                             Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0"
                             Text="只处理新增的，已整理过的自动跳过"/>
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="ModeFull" GroupName="mode" Margin="0,0,0,8"
                           Checked="Mode_Changed">
                <StackPanel>
                  <TextBlock Text="全部重来" FontSize="12"
                             Foreground="{DynamicResource B.Text}"/>
                  <TextBlock x:Name="FullDesc" FontSize="10.5"
                             Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0"
                             Text="清空记录重新分所有未归类条目"/>
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="ModeRetry" GroupName="mode" Checked="Mode_Changed">
                <StackPanel>
                  <TextBlock Text="补漏重试" FontSize="12"
                             Foreground="{DynamicResource B.Text}"/>
                  <TextBlock x:Name="RetryDesc" FontSize="10.5"
                             Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0"
                             Text="只重试之前整理失败的"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>

            <!-- ═══ ② 先分析 ═══ -->
            <TextBlock Text="② 分类方案" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}" Margin="0,0,0,8"/>

            <Border Background="{DynamicResource B.BgSide}" CornerRadius="5"
                    Padding="12,10" Margin="0,0,0,16">
              <StackPanel>
                <CheckBox x:Name="AnalyzeFirstCheck" IsChecked="True"
                          Checked="AnalyzeFirst_Changed" Unchecked="AnalyzeFirst_Changed">
                  <StackPanel>
                    <TextBlock Text="让 AI 先分析 500 条样本，生成分类方案" FontSize="11.5"
                               Foreground="{DynamicResource B.Text}"/>
                    <TextBlock x:Name="AnalyzeDesc" FontSize="10"
                               Foreground="{DynamicResource B.Text3}" Margin="0,2,0,0"
                               Text="更一致，但多花约 0.04 元"/>
                  </StackPanel>
                </CheckBox>

                <TextBlock x:Name="SkipHint" FontSize="10.5"
                           Foreground="{DynamicResource B.Warning}" Margin="0,8,0,0"
                           Text="跳过分析会直接分类，批次之间可能不一致（同类内容分到不同组）"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <!-- ═══ ③ 额外要求 ═══ -->
            <TextBlock Text="③ 告诉 AI 你的想法（可选）" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource B.Text}" Margin="0,0,0,8"/>

            <Border Background="{DynamicResource B.InputBg}" CornerRadius="5"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                    Margin="0,0,0,4">
              <TextBox x:Name="PromptBox" Style="{StaticResource BorderlessTextBox}"
                       Margin="10,8" MinHeight="52" MaxHeight="100"
                       TextWrapping="Wrap" AcceptsReturn="True" FontSize="12"
                       VerticalContentAlignment="Top"/>
            </Border>
            <TextBlock FontSize="10" Foreground="{DynamicResource B.Text3}" Margin="2,0,0,16"
                       Text="例：按工作/学习/生活分类，允许两级目录，把无效链接单独放一组"
                       TextWrapping="Wrap"/>

            <!-- ═══ 无效内容开关 ═══ -->
            <CheckBox x:Name="QuarantineCheck" IsChecked="True" Margin="0,0,0,20">
              <TextBlock Text="把无效/测试内容单独放进「00 待清理」（默认不勾选）"
                         FontSize="11.5" Foreground="{DynamicResource B.Text2}"/>
            </CheckBox>

            <!-- ═══ 开始按钮 ═══ -->
            <Button x:Name="StartBtn" Height="38" Style="{StaticResource PrimaryButton}"
                    Click="Start_Click" Margin="0,0,0,16">
              <TextBlock x:Name="StartBtnText" Text="开 始" FontSize="13"
                         FontWeight="SemiBold" Foreground="White"/>
            </Button>

            <!-- ═══ 进度 ═══ -->
            <Border x:Name="ProgressArea" Background="{DynamicResource B.BgSide}"
                    CornerRadius="5" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
              <StackPanel>
                <Grid Margin="0,0,0,6">
                  <TextBlock x:Name="PhaseText" FontSize="11"
                             Foreground="{DynamicResource B.Text2}"/>
                  <TextBlock x:Name="StatsText" FontSize="10"
                             HorizontalAlignment="Right"
                             Foreground="{DynamicResource B.Text3}"/>
                </Grid>
                <Border Height="4" CornerRadius="2" Background="{DynamicResource B.InputBg}">
                  <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Width="0"
                          HorizontalAlignment="Left"
                          Background="{DynamicResource B.Primary}"/>
                </Border>
              </StackPanel>
            </Border>

            <!-- ═══ 方案审阅区 ═══ -->
            <StackPanel x:Name="SchemeArea" Visibility="Collapsed">
              <Grid Margin="0,0,0,10">
                <TextBlock Text="④ 审阅分类方案" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource B.Text}"/>
                <Button HorizontalAlignment="Right" Height="22" Padding="8,0"
                        Style="{StaticResource FlatButton}" Click="Reanalyze_Click">
                  <TextBlock Text="重新分析" FontSize="10.5"
                             Foreground="{DynamicResource B.Text3}"/>
                </Button>
              </Grid>

              <Border Background="{DynamicResource B.InputBg}" CornerRadius="5"
                      Padding="12,10" Margin="0,0,0,10">
                <TextBlock x:Name="ProfileText" FontSize="11.5"
                           Foreground="{DynamicResource B.Text2}"
                           TextWrapping="Wrap" LineHeight="19"/>
              </Border>

              <!-- 方案切换 -->
              <StackPanel x:Name="SchemeTabs" Orientation="Horizontal" Margin="0,0,0,10"/>

              <TextBlock x:Name="RecommendText" FontSize="10.5"
                         Foreground="{DynamicResource B.Purple}" Margin="0,0,0,10"
                         TextWrapping="Wrap"/>

              <!-- 分组列表 -->
              <Border BorderBrush="{DynamicResource B.Divider}" BorderThickness="1"
                      CornerRadius="5" MaxHeight="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="SchemeGroupList" Margin="6">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Height="38" CornerRadius="4" Padding="8,0" Margin="0,1"
                                Background="Transparent" Tag="{Binding}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Path}" FontSize="11.5"
                                         Foreground="{DynamicResource B.Text}"/>
                              <TextBlock Text="{Binding Reason}" FontSize="9.5"
                                         Foreground="{DynamicResource B.Text3}" Margin="0,1,0,0"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding EstimateText}" FontSize="10.5"
                                       Foreground="{DynamicResource B.Text3}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <Button Grid.Column="3" Width="24" Height="24" Padding="0"
                                    Style="{StaticResource FlatButton}" Background="Transparent"
                                    Tag="{Binding}" Click="RenameGroup_Click" ToolTip="改名">
                              <controls:Icon Kind="Pencil" Width="11" Height="11"
                                             Stroke="{DynamicResource B.Text3}"/>
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <Button x:Name="RunSchemeBtn" Content="按这个方案开始分类"
                      Style="{StaticResource PrimaryButton}" Height="36" Margin="0,12,0,0"
                      Click="RunScheme_Click"/>
            </StackPanel>

            <!-- ═══ 结果区 ═══ -->
            <StackPanel x:Name="ResultArea" Visibility="Collapsed" Margin="0,16,0,0">
              <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="整理结果" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource B.Text}"/>
                  <TextBlock x:Name="ResultCountText" FontSize="11"
                             Foreground="{DynamicResource B.Text3}" Margin="8,0,0,0"
                             VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="全选" Style="{StaticResource FlatButton}" Height="22"
                          Padding="8,0" Click="SelectAll_Click"/>
                  <Button Content="全不选" Style="{StaticResource FlatButton}" Height="22"
                          Padding="8,0" Margin="4,0,0,0" Click="SelectNone_Click"/>
                </StackPanel>
              </Grid>

              <Border BorderBrush="{DynamicResource B.Divider}" BorderThickness="1"
                      CornerRadius="5" MaxHeight="300">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="ResultList" Margin="6">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border CornerRadius="4" Padding="8,6" Margin="0,1" Tag="{Binding}">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="Transparent"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsQuarantine}" Value="True">
                                  <Setter Property="Background" Value="#0F000000"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource B.Hover}"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>

                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                      VerticalAlignment="Top" Margin="0,2,10,0"/>

                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Preview}" FontSize="11.5"
                                         Foreground="{DynamicResource B.Text}"
                                         TextTrimming="CharacterEllipsis"/>
                              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="→ " FontSize="10"
                                           Foreground="{DynamicResource B.Text3}"/>
                                <TextBlock Text="{Binding GroupDisplay}" FontSize="10"
                                           Foreground="{DynamicResource B.Primary}"/>
                                <TextBlock Text="{Binding TagDisplay}" FontSize="10"
                                           Foreground="{DynamicResource B.Text3}" Margin="10,0,0,0"/>
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="{DynamicResource B.BgSide}"
                BorderBrush="{DynamicResource B.Divider}" BorderThickness="0,1,0,0">
          <Grid Margin="16,0">
            <TextBlock x:Name="StatusText" FontSize="10.5"
                       Foreground="{DynamicResource B.Text3}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       MaxWidth="400"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <Button x:Name="CancelRunBtn" Content="停止" Style="{StaticResource ChipButton}"
                      Height="30" Width="70" Click="CancelRun_Click" Visibility="Collapsed"/>
              <Button Content="关闭" Style="{StaticResource ChipButton}" Height="30" Width="70"
                      Margin="8,0,0,0" Click="Close_Click"/>
              <Button x:Name="ApplyBtn" Content="应用" Style="{StaticResource PrimaryButton}"
                      Height="30" MinWidth="90" Padding="12,0" Margin="8,0,0,0"
                      Click="Apply_Click" IsEnabled="False"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
