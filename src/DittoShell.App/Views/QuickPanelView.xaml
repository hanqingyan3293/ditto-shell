<Window x:Class="DittoShell.App.Views.QuickPanelView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DittoShell.App.Controls"
        xmlns:vm="clr-namespace:DittoShell.App.ViewModels"
        xmlns:loc="clr-namespace:DittoShell.App.Localization"
        xmlns:views="clr-namespace:DittoShell.App.Views"
        Title="Ditto Shell" Width="380" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        ResizeMode="CanResize" MinWidth="320" MinHeight="280" MaxHeight="900"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

  <Grid Margin="1">
    <Border Background="{DynamicResource B.Bg}" CornerRadius="2">
      <Border.Effect>
        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#101828"/>
      </Border.Effect>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="GroupColumn" Width="0"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="DetailDivider" Width="0"/>
          <ColumnDefinition x:Name="DetailColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
          <RowDefinition Height="42"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 拖动条：按住顶部 8px 可移动面板（覆盖在最上层） -->
        <Border x:Name="DragBar" Grid.Row="0" Grid.ColumnSpan="4" Height="8" VerticalAlignment="Top"
                Background="Transparent" Cursor="SizeAll"
                MouseLeftButtonDown="TitleBar_Drag" Panel.ZIndex="999"/>

        <!-- 搜索行 -->
        <Border Grid.Column="1" Grid.Row="0" BorderBrush="{DynamicResource B.Divider}" BorderThickness="0,0,0,1">
          <Grid Margin="14,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:Icon Grid.Column="0" Kind="Search" Width="14" Height="14"
                           Stroke="{DynamicResource B.Text3}" Margin="0,0,8,0"/>

            <!-- 前缀 chip -->
            <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource B.Primary}" CornerRadius="3"
                    Padding="5,1" Margin="20,0,0,0" Panel.ZIndex="2"
                    Visibility="{Binding HasPrefix, Converter={StaticResource BoolToVis}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ActivePrefix}" FontSize="11" Foreground="White"
                           FontFamily="{StaticResource Font.Mono}"/>
                <Button Width="13" Height="13" Padding="0" Margin="3,0,0,0"
                        Style="{StaticResource FlatButton}" Background="Transparent"
                        Command="{Binding ClearPrefixCommand}">
                  <TextBlock Text="×" FontSize="11" Foreground="White"/>
                </Button>
              </StackPanel>
            </Border>

            <Grid Grid.Column="1">
              <TextBox x:Name="SearchBox" Style="{StaticResource BorderlessTextBox}" FontSize="13"
                       Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                       PreviewKeyDown="SearchBox_PreviewKeyDown"/>
              <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" FontSize="13"
                         Foreground="{DynamicResource B.Text3}"
                         Text="{Binding Source={x:Static loc:L.Instance}, Path=[quick.searchPlaceholder]}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>

            <Button Grid.Column="2" Height="22" Width="26" Padding="0"
                    Style="{StaticResource FlatButton}" Click="Close_Click" ToolTip="关闭面板"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                    Background="{DynamicResource B.Bg}">
              <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource B.Text3}"/>
            </Button>
          </Grid>
        </Border>

        <!-- 列表 -->
        <ListBox Grid.Column="1" Grid.Row="1" x:Name="ItemsList" ItemsSource="{Binding Items}" AlternationCount="2"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="3,3,3,0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="0">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Zebra}"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.RowHover}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Selected}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>

          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ClipRowVM}">
              <Grid Height="42" Margin="5,0" Background="Transparent"
                    MouseEnter="Row_MouseEnter" MouseLeave="Row_MouseLeave">
                  <Grid.ContextMenu>
                    <ContextMenu Placement="MousePoint" MaxWidth="280" Opened="Menu_Opened">
                      <MenuItem Header="组" Tag="group">
                        <MenuItem Header="移到分组…" Tag="movegroup" Click="ClipMenu_Click"/>
                        <MenuItem Header="取消归类" Tag="ungroup" Click="ClipMenu_Click"/>
                      </MenuItem>
                      <MenuItem Header="查看完整说明" Tag="detail" Click="ClipMenu_Click"
                                InputGestureText="→"/>
                      <MenuItem Header="特殊粘贴" Tag="specialpaste">
                        <MenuItem Header="纯文本" Tag="plain" Click="ClipMenu_Click"/>
                        <MenuItem Header="保留原格式" Tag="paste" Click="ClipMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="复制 HTML 源码" Tag="copyhtml" Click="ClipMenu_Click"/>
                        <MenuItem Header="查看原图" Tag="image" Click="ClipMenu_Click"/>
                      </MenuItem>
                      <MenuItem Header="使用所选条目进行过滤" Tag="filterby" Click="ClipMenu_Click"/>
                      <Separator/>
                      <MenuItem Header="删除条目" Tag="delete" Click="ClipMenu_Click"
                                InputGestureText="Delete"/>
                      <MenuItem Header="编辑剪贴项" Tag="edit" Click="ClipMenu_Click"/>
                      <MenuItem Header="新建剪贴项" Tag="newitem" Click="ClipMenu_Click"/>
                      <Separator/>
                      <MenuItem Header="属性" Tag="props" Click="ClipMenu_Click"/>
                      <MenuItem Header="快捷属性" Tag="quickprops">
                        <MenuItem Header="禁止自动删除" Tag="keep" Click="ClipMenu_Click"/>
                        <MenuItem Header="允许自动删除" Tag="unkeep" Click="ClipMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="标记为隐私" Tag="privacy" Click="ClipMenu_Click"/>
                        <MenuItem Header="打开来源程序" Tag="opensource" Click="ClipMenu_Click"/>
                      </MenuItem>
                      <MenuItem Header="剪贴项排序" Tag="clipsort">
                        <MenuItem Header="置顶" Tag="sticky" Click="ClipMenu_Click"/>
                        <MenuItem Header="取消置顶" Tag="unsticky" Click="ClipMenu_Click"/>
                      </MenuItem>
                      <MenuItem Header="导入 / 导出" Tag="io">
                        <MenuItem Header="导出为文本" Tag="exporttxt" Click="ClipMenu_Click"/>
                        <MenuItem Header="导出为 JSON" Tag="exportjson" Click="ClipMenu_Click"/>
                        <MenuItem Header="复制到剪贴板" Tag="copy" Click="ClipMenu_Click"/>
                      </MenuItem>
                    </ContextMenu>
                  </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding IndexLabel}" FontSize="10"
                           Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>

                <Grid Grid.Column="1" Width="34" Height="34" Margin="8,0" VerticalAlignment="Center">
                  <Border x:Name="dotBg" CornerRadius="4" Background="{Binding KindBrush}" Opacity="0.12"/>
                  <controls:Icon x:Name="ki" Kind="{Binding KindIcon}" Width="16" Height="16"
                                 Stroke="{Binding KindBrush}"/>
                  <Border x:Name="thumbBox" CornerRadius="4" Visibility="Collapsed" ClipToBounds="True">
                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                  </Border>
                </Grid>

                <TextBlock x:Name="pt" Grid.Column="2" Text="{Binding Preview}" FontSize="12"
                           Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border x:Name="sens" Background="#FFF2F0" BorderBrush="#FFFFCCC7" BorderThickness="1"
                          CornerRadius="3" Padding="4,0" Height="15" Margin="0,0,6,0" Visibility="Collapsed">
                    <TextBlock Text="{Binding Source={x:Static loc:L.Instance}, Path=[quick.badge.sensitive]}"
                               FontSize="9.5" Foreground="{DynamicResource B.Danger}"/>
                  </Border>
                  <TextBlock Text="{Binding TimeText}" FontSize="10"
                             Foreground="{DynamicResource B.Text3}" Margin="0,0,4,0"/>
                </StackPanel>
              </Grid>

              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSensitive}" Value="True">
                  <Setter TargetName="sens" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                  <Setter TargetName="dotBg" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="ki" Property="Visibility" Value="Collapsed"/>
                  <Setter TargetName="thumbBox" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="pt" Property="Foreground" Value="{DynamicResource B.Primary}"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 底栏 -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource B.Divider}" BorderThickness="0,1,0,0">
          <Grid Margin="12,0,8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="↑↓ 选择" FontSize="9.5" Foreground="{DynamicResource B.Text3}" Margin="0,0,8,0"/>
              <TextBlock Text="↵ 粘贴" FontSize="9.5" Foreground="{DynamicResource B.Text3}" Margin="0,0,8,0"/>
              <TextBlock Text="1-9 直粘" FontSize="9.5" Foreground="{DynamicResource B.Text3}" Margin="0,0,8,0"/>
              <TextBlock Text="/ 筛选" FontSize="9.5" Foreground="{DynamicResource B.Text3}" Margin="0,0,8,0"/>
              <Button Height="20" Padding="6,0" Style="{StaticResource FlatButton}" Click="ToggleGroup_Click"
                    ToolTip="显示 / 隐藏分组栏">
              <TextBlock Text="Tab 分组" FontSize="9.5" Foreground="{DynamicResource B.Primary}"/>
            </Button>
            </StackPanel>

            <Button Grid.Column="1" Height="26" Padding="9,0" VerticalAlignment="Center"
                    Command="{Binding ManageCommand}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="b" CornerRadius="5" Background="#141677FF"
                          BorderBrush="#2E1677FF" BorderThickness="1" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Source={x:Static loc:L.Instance}, Path=[quick.manage]}"
                                 FontSize="11.5" FontWeight="SemiBold"
                                 Foreground="{DynamicResource B.Primary}"/>
                      <controls:Icon Kind="ArrowRight" Width="11" Height="11" Margin="4,0,0,0"
                                     Stroke="{DynamicResource B.Primary}"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="b" Property="Background" Value="#241677FF"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>

        <!-- ══════ 分组浮层 ══════ -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                Background="{DynamicResource B.BgSide}"
                BorderBrush="{DynamicResource B.Divider}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsGroupOpen, Converter={StaticResource BoolToVis}}">
          <Border Background="Transparent" Margin="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="13,11,13,6">
                <TextBlock Text="{Binding Source={x:Static loc:L.Instance}, Path=[main.sidebar.groups]}"
                           FontSize="10" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center"/>
                <TextBlock Text="35" FontSize="10" Foreground="{DynamicResource B.Text3}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="340">
                <StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GroupRowVM}">
                      <Border x:Name="bd" Height="32" CornerRadius="6" Background="Transparent"
                              Padding="{Binding Padding}" Margin="5,1" Tag="{Binding}"
                              MouseLeftButtonUp="GroupItem_Click">
                        <Border.ContextMenu>
                          <ContextMenu Opened="Menu_Opened">
                            <MenuItem Header="新建子组" Click="GroupCtx_NewSub"/>
                            <MenuItem Header="重命名" Click="GroupCtx_Rename"/>
                            <Separator/>
                            <MenuItem Header="移到顶层" Click="GroupCtx_MoveTop"/>
                            <MenuItem Header="删除分组" Click="GroupCtx_Delete"/>
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Button Grid.Column="0" Width="13" Height="13" Padding="0" Margin="0,0,3,0"
                                  Style="{StaticResource FlatButton}" Background="Transparent"
                                  Tag="{Binding}" Click="GroupArrow_Click"
                                  Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}">
                            <controls:Icon Width="8" Height="8" Stroke="{DynamicResource B.Text3}"
                                           Kind="{Binding ArrowGlyph}"/>
                          </Button>
                          <controls:Icon x:Name="ic" Grid.Column="1" Kind="{Binding Icon}" Width="13" Height="13"
                                         Stroke="{DynamicResource B.Text3}" Margin="0,0,8,0"/>
                          <TextBlock x:Name="tx" Grid.Column="2" Text="{Binding Name}" FontSize="12.5"
                                     Foreground="{DynamicResource B.Text2}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="3" Text="{Binding Count}" FontSize="10.5"
                                     Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Selected}"/>
                          <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource B.Primary}"/>
                          <Setter TargetName="tx" Property="FontWeight" Value="SemiBold"/>
                          <Setter TargetName="ic" Property="Stroke" Value="{DynamicResource B.Primary}"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
              </ScrollViewer>

              <Border Grid.Row="2" BorderBrush="{DynamicResource B.Divider}" BorderThickness="0,1,0,0">
                <Grid Margin="13,0">
                  <TextBlock Text="右键操作"
                             FontSize="9.5" Foreground="{DynamicResource B.Text3}" VerticalAlignment="Center" Margin="0,0,44,0" TextTrimming="CharacterEllipsis"/>
                  <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="20"
                          Padding="6,0" Style="{StaticResource FlatButton}" Click="NewGroup_Click">
                    <StackPanel Orientation="Horizontal">
                      <controls:Icon Kind="Plus" Width="11" Height="11" Stroke="{DynamicResource B.Primary}"/>
                      <TextBlock Text="新建" FontSize="11" Margin="4,0,0,0" Foreground="{DynamicResource B.Primary}"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Border>

        <!-- ══════ 详情列（按 → 展开）══════ -->
        <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      ShowsPreview="False" Cursor="SizeWE"
                      Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
          <GridSplitter.Template>
            <ControlTemplate TargetType="GridSplitter">
              <Border Background="Transparent">
                <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource B.Divider}"/>
              </Border>
            </ControlTemplate>
          </GridSplitter.Template>
        </GridSplitter>

        <Border Grid.Column="3" Grid.RowSpan="3" Background="{DynamicResource B.Bg}"
                BorderBrush="{DynamicResource B.Divider}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="14,12,14,8">
              <TextBlock Text="{Binding Selected.Preview}" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource B.Text}" TextWrapping="Wrap" MaxHeight="44"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding Selected.MetaText}" FontSize="10.5" Margin="0,4,0,0"
                         Foreground="{DynamicResource B.Text3}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="14,0,14,0" VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding DetailText}" FontSize="11.5" TextWrapping="Wrap"
                         FontFamily="{StaticResource Font.Mono}"
                         Foreground="{DynamicResource B.Text2}"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,8,14,12">
              <Button Style="{StaticResource PrimaryButton}" Height="28" Padding="10,0"
                      Command="{Binding PasteCommand}">
                <TextBlock Text="粘贴" FontSize="11.5" Foreground="White"/>
              </Button>
              <Button Style="{StaticResource ChipButton}" Height="28" Margin="6,0,0,0"
                      Command="{Binding PastePlainCommand}">
                <TextBlock Text="纯文本" FontSize="11.5" Foreground="{DynamicResource B.Text2}"/>
              </Button>
              <Button Style="{StaticResource ChipButton}" Height="28" Margin="6,0,0,0"
                      Click="CopyDetail_Click">
                <TextBlock Text="复制" FontSize="11.5" Foreground="{DynamicResource B.Text2}"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ══════ 快速筛选栏 ══════ -->
        <Grid Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2" Background="#22000000"
              Visibility="{Binding IsFilterBarOpen, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="FilterBarOverlay_Click">
          <Border MaxHeight="400" VerticalAlignment="Top" Margin="8,6,8,0"
                  Background="{DynamicResource B.Bg}" CornerRadius="6"
                  BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
            <Border.Effect>
              <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270"
                                Opacity="0.12" Color="#101828"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="12,10,8,6">
                <TextBlock FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource B.Text3}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="选择筛选条件"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding FilterTab}" Value="tag">
                          <Setter Property="Text" Value="选择标签"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FilterTab}" Value="type">
                          <Setter Property="Text" Value="选择类型"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FilterTab}" Value="from">
                          <Setter Property="Text" Value="选择来源"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FilterTab}" Value="age">
                          <Setter Property="Text" Value="选择时间范围"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Button HorizontalAlignment="Right" Height="20" Padding="8,0"
                        Style="{StaticResource FlatButton}" Command="{Binding CloseFilterBarCommand}">
                  <TextBlock Text="取消" FontSize="10.5" Foreground="{DynamicResource B.Text3}"/>
                </Button>
              </Grid>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="330">
                <StackPanel Margin="6,0,6,8">
                  <!-- 类型 / 时间：固定选项 -->
                  <ItemsControl ItemsSource="{Binding FilterChoices}" x:Name="ChoiceList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Height="30" CornerRadius="4" Padding="10,0" Margin="0,1"
                                Background="Transparent" Cursor="Hand" Tag="{Binding}"
                                MouseLeftButtonUp="FilterChoice_Click">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource B.Hover}"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <Grid>
                            <TextBlock Text="{Binding Label}" FontSize="12"
                                       Foreground="{DynamicResource B.Text2}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CountText}" FontSize="10.5"
                                       Foreground="{DynamicResource B.Text3}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- 类型 / 时间的内置选项 -->
                  <StackPanel>
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding FilterTab}" Value="type">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding FilterTab}" Value="age">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <!-- ══════ 斜杠面板 ══════ -->
        <Grid Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2" Background="#33000000"
              Visibility="{Binding IsSlashOpen, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="SlashOverlay_Click">
          <Border MaxHeight="430" VerticalAlignment="Top" Margin="8,6,8,0"
                  Background="{DynamicResource B.Bg}" CornerRadius="10">
            <Border.Effect>
              <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.24" Color="#101828"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Margin="13,10,13,4"
                         Text="{Binding Source={x:Static loc:L.Instance}, Path=[slash.filters]}"
                         FontSize="10" Foreground="{DynamicResource B.Text3}"/>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="350">
                <ItemsControl ItemsSource="{Binding SlashItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SlashItemVM}">
                      <Border Height="40" CornerRadius="7" Background="Transparent" Margin="5,1"
                              Padding="8,0" Tag="{Binding}" Cursor="Hand"
                              MouseLeftButtonUp="SlashItem_Click">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                                  Background="{Binding Color}" Opacity="0.12" Margin="0,0,9,0"/>
                          <controls:Icon Grid.Column="0" Kind="{Binding Icon}" Width="13" Height="13"
                                         Stroke="{Binding Color}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"/>
                          <Border Grid.Column="2" Background="{DynamicResource B.InputBg}" CornerRadius="3"
                                  Padding="5,0" Height="17" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Alias}" FontSize="10.5"
                                       FontFamily="{StaticResource Font.Mono}"
                                       Foreground="{DynamicResource B.Text3}"/>
                          </Border>
                          <TextBlock Grid.Column="3" Text="{Binding Hint}" FontSize="11"
                                     Foreground="{DynamicResource B.Text3}" HorizontalAlignment="Right"
                                     VerticalAlignment="Center" Margin="8,0"/>

                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Border Grid.Column="1" Grid.Row="2" BorderBrush="{DynamicResource B.Divider}" BorderThickness="0,1,0,0">
                <Grid Margin="10,0">
                  <TextBlock VerticalAlignment="Center" FontSize="9.5"
                             Foreground="{DynamicResource B.Text3}"
                             Text="↑↓ 选择   ↵ 确定   1-9 直粘"/>
                  <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="22"
                          Padding="8,0" Style="{StaticResource FlatButton}" Click="ToggleGroup_Click"
                          ToolTip="显示 / 隐藏分组栏（Tab）">
                    <StackPanel Orientation="Horizontal">
                      <controls:Icon Kind="Layers" Width="11" Height="11" Stroke="{DynamicResource B.Primary}"/>
                      <TextBlock Text="分组" FontSize="10.5" Margin="4,0,0,0" Foreground="{DynamicResource B.Primary}"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <Popup x:Name="HoverPop" Placement="Absolute" AllowsTransparency="True" StaysOpen="True"
           PopupAnimation="Fade" HorizontalOffset="18" VerticalOffset="10">
      <views:HoverPreview x:Name="HoverCard" IsHitTestVisible="False"/>
    </Popup>

  </Grid>
</Window>
