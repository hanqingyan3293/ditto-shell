<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色主题 Token · 数值来自 docs/spec/05-ui-spec.md -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="C.Bg">#FFFFFFFF</Color>
  <Color x:Key="C.BgSide">#FFF7F7F8</Color>
  <Color x:Key="C.Hover">#FFF5F5F5</Color>
  <Color x:Key="C.Selected">#FFE6F4FF</Color>
  <Color x:Key="C.SelectedHover">#FFD8ECFF</Color>
  <Color x:Key="C.Text">#E1000000</Color>
  <Color x:Key="C.Text2">#A6000000</Color>
  <Color x:Key="C.Text3">#73000000</Color>
  <Color x:Key="C.Border">#FFE8E8E8</Color>
  <Color x:Key="C.Divider">#FFF0F0F0</Color>
  <Color x:Key="C.Primary">#FF1677FF</Color>
  <Color x:Key="C.PrimaryDim">#1A1677FF</Color>
  <Color x:Key="C.Brand">#FF722ED1</Color>
  <Color x:Key="C.Success">#FF52C41A</Color>
  <Color x:Key="C.Warning">#FFFA8C16</Color>
  <Color x:Key="C.Danger">#FFFF4D4F</Color>
  <Color x:Key="C.Magenta">#FFEB2F96</Color>
  <Color x:Key="C.Cyan">#FF13C2C2</Color>
  <Color x:Key="C.Purple">#FF722ED1</Color>
  <Color x:Key="C.InputBg">#FFF5F5F5</Color>
  <Color x:Key="C.CardBg">#FFFAFAFA</Color>

  <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}"/>
  <SolidColorBrush x:Key="B.RowHover" Color="#FFEFF6FF"/>
  <SolidColorBrush x:Key="B.Zebra" Color="#0F000000"/>
  <SolidColorBrush x:Key="B.ScrollThumb" Color="#66000000"/>
  <SolidColorBrush x:Key="B.BgSide" Color="{StaticResource C.BgSide}"/>
  <SolidColorBrush x:Key="B.Hover" Color="{StaticResource C.Hover}"/>
  <SolidColorBrush x:Key="B.Selected" Color="{StaticResource C.Selected}"/>
  <SolidColorBrush x:Key="B.SelectedHover" Color="{StaticResource C.SelectedHover}"/>
  <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}"/>
  <SolidColorBrush x:Key="B.Text2" Color="{StaticResource C.Text2}"/>
  <SolidColorBrush x:Key="B.Text3" Color="{StaticResource C.Text3}"/>
  <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}"/>
  <SolidColorBrush x:Key="B.Divider" Color="{StaticResource C.Divider}"/>
  <SolidColorBrush x:Key="B.Primary" Color="{StaticResource C.Primary}"/>
  <SolidColorBrush x:Key="B.PrimaryDim" Color="{StaticResource C.PrimaryDim}"/>
  <SolidColorBrush x:Key="B.Brand" Color="{StaticResource C.Brand}"/>
  <SolidColorBrush x:Key="B.Success" Color="{StaticResource C.Success}"/>
  <SolidColorBrush x:Key="B.Warning" Color="{StaticResource C.Warning}"/>
  <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}"/>
  <SolidColorBrush x:Key="B.Magenta" Color="{StaticResource C.Magenta}"/>
  <SolidColorBrush x:Key="B.Cyan" Color="{StaticResource C.Cyan}"/>
  <SolidColorBrush x:Key="B.Purple" Color="{StaticResource C.Purple}"/>
  <SolidColorBrush x:Key="B.InputBg" Color="{StaticResource C.InputBg}"/>
  <SolidColorBrush x:Key="B.CardBg" Color="{StaticResource C.CardBg}"/>

</ResourceDictionary>
